{
  "pages": [
    "pages/index/index",
    "pages/result/result",
    "pages/history/history"
  ],
  "window": {
    "navigationBarTitleText": "明白卡",
    "navigationBarBackgroundColor": "#FFFFFF",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F5F5F0",
    "backgroundColorTop": "#F5F5F0",
    "backgroundColorBottom": "#F5F5F0"
  },
  "permission": {
    "scope.writePhotosAlbum": {
      "desc": "用于保存行动卡图片，方便老人反复查看"
    },
    "scope.camera": {
      "desc": "用于拍摄纸质通知或群消息截图"
    }
  },
  "networkTimeout": {
    "request": 600000
  },
  "supportedMaterials": [
    {
      "materialType": "image/*",
      "name": "用${nickname}看懂",
      "desc": "把群通知变成能听懂的行动卡",
      "path": "pages/index/index"
    }
  ],
  "sitemapLocation": "sitemap.json",
  "style": "v2"
}
