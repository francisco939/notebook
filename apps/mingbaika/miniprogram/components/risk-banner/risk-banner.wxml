<!-- 顶部拦截式风险提示（仅 danger 级）。显著、不可忽略。 -->
<view class="banner" wx:if="{{risks.length}}">
  <view class="banner-head">
    <text class="banner-icon">⚠️</text>
    <text class="banner-title">注意，这条要先确认</text>
  </view>
  <view class="banner-item" wx:for="{{risks}}" wx:key="index">
    <view class="banner-item-title">· {{item.title}}</view>
    <view class="banner-item-evidence" wx:if="{{item.evidence}}">原文：{{item.evidence}}</view>
  </view>
  <view class="banner-foot">建议先打电话核实，不要急着交钱</view>
</view>
