/* 顶部拦截式风险提示条：深红底、白字、强对比 */
.banner {
  background: #B71C1C;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(183, 28, 28, 0.3);
}

.banner-head {
  display: flex;
  align-items: center;
}
.banner-icon { font-size: 44rpx; margin-right: 12rpx; }
.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.banner-item {
  margin-top: 18rpx;
  padding-left: 8rpx;
}
.banner-item-title {
  font-size: 36rpx;
  line-height: 1.5;
}
.banner-item-evidence {
  font-size: 30rpx;
  color: #FFD9D9;
  margin-top: 4rpx;
}

.banner-foot {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-top: 2rpx solid rgba(255, 255, 255, 0.4);
  padding-top: 16rpx;
}
