<!-- 行动卡组件：根据 card 渲染大字行动卡。降级卡只显示原文。 -->
<view class="card" wx:if="{{view}}">

  <!-- 降级卡：没看懂，只给原文 + 提示 -->
  <block wx:if="{{view.degraded}}">
    <view class="title">{{view.title}}</view>
    <view class="summary">{{view.summary}}</view>
    <view class="raw-box">
      <text class="raw-label">原文</text>
      <text class="raw-text" user-select="{{true}}">{{view.rawText}}</text>
    </view>
  </block>

  <!-- 正常卡 -->
  <block wx:else>
    <view class="title">{{view.title}}</view>
    <view class="summary" wx:if="{{view.summary}}">{{view.summary}}</view>
    <view class="publisher" wx:if="{{view.publisher}}">来自：{{view.publisher}}</view>

    <view class="items">
      <view class="item" wx:for="{{view.items}}" wx:key="index">
        <view class="item-index">{{index + 1}}</view>
        <view class="item-body">
          <view class="item-what">{{item.what}}</view>

          <view class="item-meta" wx:if="{{item.dlText || item.amountText || item.location || item.carryText}}">
            <view class="meta-line" wx:if="{{item.dlText}}">
              <text class="meta-tag">时间</text>
              <text class="meta-val">{{item.dlText}}</text>
            </view>
            <!-- 低置信度：并列展示原文片段，让老人自己核对 -->
            <view class="raw-check" wx:if="{{item.dlRaw}}">
              原文这样写：{{item.dlRaw}}
            </view>

            <view class="meta-line" wx:if="{{item.amountText}}">
              <text class="meta-tag">金额</text>
              <text class="meta-val amount">{{item.amountText}}</text>
            </view>
            <view class="raw-check" wx:if="{{item.amountRaw}}">
              原文这样写：{{item.amountRaw}}
            </view>

            <view class="meta-line" wx:if="{{item.location}}">
              <text class="meta-tag">地点</text>
              <text class="meta-val">{{item.location}}</text>
            </view>

            <view class="meta-line" wx:if="{{item.carryText}}">
              <text class="meta-tag">带</text>
              <text class="meta-val">{{item.carryText}}</text>
            </view>

            <view class="meta-note" wx:if="{{item.note}}">{{item.note}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- info / warn 级风险提示 -->
    <view class="risks" wx:if="{{view.risks.length}}">
      <view class="risk risk-{{item.level}}" wx:for="{{view.risks}}" wx:key="index">
        <view class="risk-title">
          <text wx:if="{{item.level === 'warn'}}">⚠️ </text>{{item.title}}
        </view>
        <view class="risk-evidence" wx:if="{{item.evidence}}">原文：{{item.evidence}}</view>
      </view>
    </view>
  </block>

</view>
