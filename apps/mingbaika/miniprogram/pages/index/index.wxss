.page {
  padding: 40rpx 32rpx 60rpx;
  min-height: 100vh;
}

.hero { margin-bottom: 48rpx; }
.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 34rpx;
  color: #595959;
  line-height: 1.6;
}

.entries { display: flex; flex-direction: column; gap: 28rpx; margin-bottom: 40rpx; }
.entry { width: 100%; }

.tip { margin-bottom: 40rpx; }
.tip-title { font-size: 38rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 16rpx; }
.tip-line { font-size: 32rpx; color: #595959; line-height: 1.9; }

.history-link { justify-content: center; margin-top: 8rpx; }
.history-text { font-size: 34rpx; color: #1B5E20; }

/* 加载遮罩：半透明、不跳转 */
.loading-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-box {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 56rpx;
}
.loading-text { font-size: 38rpx; color: #1A1A1A; }
