.page {
  padding: 28rpx 24rpx 60rpx;
  min-height: 100vh;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 28rpx 28rpx;
}

.item-main { flex: 1; min-width: 0; }
.item-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-sub {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #595959;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-right { flex: 0 0 auto; margin-left: 20rpx; text-align: right; }
.item-time { font-size: 28rpx; color: #8A8A82; }
.item-danger {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #B71C1C;
  font-weight: 600;
}

.clear-btn { width: 100%; margin-top: 16rpx; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: 120rpx;
}
.empty-text { font-size: 36rpx; color: #595959; }
