<!-- 历史列表页：按时间倒序，一屏一卡列表。 -->
<view class="page">

  <view class="empty" wx:if="{{!list.length}}">
    <view class="empty-text">还没有记录</view>
    <button class="btn btn-ghost" bindtap="onBackHome">去识别一条</button>
  </view>

  <view wx:else>
    <view class="item panel tap" wx:for="{{list}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onTapItem">
      <view class="item-main">
        <view class="item-title">{{item.title}}</view>
        <view class="item-sub" wx:if="{{item.summary}}">{{item.summary}}</view>
      </view>
      <view class="item-right">
        <view class="item-time">{{item.time}}</view>
        <view class="item-danger" wx:if="{{item.danger}}">⚠️ 需确认</view>
      </view>
    </view>

    <button class="btn btn-ghost clear-btn" bindtap="onClear">清空历史</button>
  </view>

</view>
