.page {
  padding: 32rpx 28rpx 180rpx;  /* 底部留白给常驻拨号条 */
  min-height: 100vh;
}

.speak-btn { width: 100%; margin-top: 28rpx; }

/* 底部常驻拨号条 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #F5F5F0;
  border-top: 2rpx solid #D9D9D2;
}
.call-btn { width: 100%; }

.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32rpx; }
.empty-text { font-size: 36rpx; color: #595959; }
