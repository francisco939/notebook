<!-- 行动卡页：一屏一卡。顶部危险拦截条 + 大字卡 + 常驻拨号。 -->
<view class="page" wx:if="{{card}}">

  <!-- 危险级风险提示：顶部拦截式 -->
  <risk-banner risks="{{dangers}}" wx:if="{{dangers.length}}"></risk-banner>

  <!-- 行动卡本体 -->
  <action-card card="{{card}}"></action-card>

  <!-- 朗读按钮（非底部常驻，放在卡片下方便捷触发） -->
  <button class="btn btn-ghost speak-btn" bindtap="onSpeak">🔊 读给我听</button>

  <!-- 底部常驻：一键拨号 -->
  <view class="footer">
    <button class="btn btn-primary call-btn" bindtap="onCall">📞 一键拨号</button>
  </view>

</view>

<view class="page empty" wx:elif="{{notFound}}">
  <view class="empty-text">没找到这张卡，可能已被清理。</view>
  <button class="btn btn-ghost" bindtap="onBackHome">返回首页</button>
</view>
