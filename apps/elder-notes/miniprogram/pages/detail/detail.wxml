<!--
  看一页：一屏只做一件事——把这条内容用最大字号看清楚。
  底部只有两个按钮：改 / 删。不给第三个选择，避免决策负担 [S17]
  （完成 / 跳过 在首页卡片上直接点，那里按钮更大、更顺手）
-->
<view class="page {{scaleClass}}">

  <view class="detail-card">
    <view class="t-body detail-title">{{title}}</view>
    <text class="t-aux detail-desc" wx:if="{{content}}">{{content}}</text>
  </view>

  <view class="when-row" wx:if="{{timeText}}">
    <text class="t-aux">时间：</text>
    <text class="t-title">{{timeText}}</text>
    <!-- 状态不只靠颜色 [S2][S4] -->
    <text wx:if="{{overdue}}" class="tag-overdue">已过</text>
  </view>

  <view class="when-row" wx:if="{{status !== 'todo'}}">
    <text class="t-aux">状态：</text>
    <text class="t-title">{{status === 'done' ? '已完成' : '已跳过'}}</text>
  </view>

  <view class="when-row" wx:if="{{author}}">
    <text class="t-aux">谁记的：</text>
    <text class="t-title">{{author}}</text>
  </view>

  <view class="btn-row">
    <view class="btn btn-ghost btn-half" bindtap="goEdit" hover-class="hover">✏️ 改一下</view>
    <view class="btn btn-danger btn-half" bindtap="doDelete" hover-class="hover">🗑 删掉</view>
  </view>

</view>
