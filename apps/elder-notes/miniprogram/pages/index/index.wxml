<!--
  首页：每日闯关 · 日历

  结构（从上到下）：
    1. 找一找（搜索）—— 保留原有能力，不因为改版而丢功能
    2. 横向日历条 —— 选日期，点一下只看那一天，再点一下回到全部
    3. 关卡列表 —— 一天一关，关内是当天的事件卡片
    4. 底部「＋ 记一条」 + 撤销条

  设计约束（改这个文件前先看）：
    - 字号、热区一律走 app.wxss 的变量，不写死小值
    - 状态**不只靠颜色**，必须有文字（已完成 / 已跳过）[S2][S4]
    - 每个可点元素都带文字，不做纯图标按钮 [S12]
    - 不用多指手势 [S17]，全部单击可达
-->
<view class="page {{scaleClass}}">

  <!-- 页头：左边是名字，右边是设置入口。
       原来只有首启那一条小提示条能进设置，而它指望"不会探索"的老人主动发现，
       已被判定无效并删除 —— 这里补一个常驻、带文字的出口。 -->
  <view class="app-head">
    <text class="t-title head-name">记得</text>
    <view class="head-btn" bindtap="goSettings" hover-class="hover">字的大小</view>
  </view>

  <!-- 找一找 -->
  <view class="search-wrap">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="找一找"
        placeholder-class="search-ph"
        confirm-type="search"
        bindinput="onSearch"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">清空</text>
    </view>
  </view>

  <!-- 横向日历条。横滚用 white-space:nowrap + inline-flex 的经典写法，
       不依赖 enable-flex（该属性在不同基础库下行为有差异，容易踩坑）。 -->
  <scroll-view class="strip" scroll-x>
    <view class="strip-inner">
      <view
        wx:for="{{strip}}"
        wx:key="key"
        class="day {{item.isToday ? 'day-today' : ''}} {{item.hasEvent ? 'day-has' : ''}} {{filterKey === item.key ? 'day-on' : ''}}"
        data-k="{{item.key}}"
        bindtap="pickDay"
        hover-class="hover"
      >
        <text class="day-week">{{item.rel || item.week}}</text>
        <text class="day-num">{{item.d}}</text>
        <view class="day-dot" wx:if="{{item.hasEvent}}"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 只看某一天时的提示，给一个明确的"退回去"出口 -->
  <view class="filter-bar" wx:if="{{filterKey}}">
    <text class="t-aux filter-text">只看 {{filterLabel}}</text>
    <view class="filter-btn" bindtap="clearDay" hover-class="hover">看全部</view>
  </view>

  <!-- 关卡列表 -->
  <block wx:for="{{levels}}" wx:key="key" wx:for-item="lv">

    <view class="level-head">
      <view class="level-row">
        <text class="t-section level-no">第 {{lv.level}} 关</text>
        <text class="t-title level-date">{{lv.label.md}} {{lv.label.week}}</text>
        <text class="t-aux level-rel" wx:if="{{lv.label.rel}}">{{lv.label.rel}}</text>
      </view>

      <view class="bar">
        <view class="bar-fill {{lv.allDone ? 'bar-full' : ''}}" style="width: {{lv.pct}}%"></view>
      </view>

      <text class="t-aux level-prog">
        <block wx:if="{{lv.allDone}}">这一关都处理完了</block>
        <block wx:else>{{lv.done}} / {{lv.total}} 已完成</block>
      </text>
    </view>

    <view
      wx:for="{{lv.items}}"
      wx:key="id"
      wx:for-item="it"
      class="card quest-card q-{{it.status}}"
      data-id="{{it.id}}"
      bindtap="openDetail"
      hover-class="hover"
    >
      <view class="q-top">
        <text class="t-title q-title">{{it.title}}</text>
        <text class="q-badge" wx:if="{{it.status === 'done'}}">已完成</text>
        <text class="q-badge q-badge-skip" wx:elif="{{it.status === 'skipped'}}">已跳过</text>
      </view>

      <text class="t-aux q-desc" wx:if="{{it.desc}}">{{it.desc}}</text>

      <view class="q-meta">
        <text class="t-aux q-author" wx:if="{{it.author}}">{{it.author}} 记的</text>
      </view>

      <!-- 阻止冒泡用 catchtap，否则会顺带触发卡片的打开详情 -->
      <view class="q-actions">
        <view
          wx:if="{{it.status === 'todo'}}"
          class="q-btn q-btn-done"
          data-id="{{it.id}}" data-s="done"
          catchtap="setStatus" hover-class="hover"
        >完成了</view>
        <view
          wx:if="{{it.status === 'todo'}}"
          class="q-btn q-btn-skip"
          data-id="{{it.id}}" data-s="skipped"
          catchtap="setStatus" hover-class="hover"
        >跳过</view>
        <view
          wx:else
          class="q-btn q-btn-undo"
          data-id="{{it.id}}" data-s="todo"
          catchtap="setStatus" hover-class="hover"
        >撤销</view>
      </view>
    </view>

  </block>

  <!-- 空状态 -->
  <view wx:if="{{levels.length === 0}}" class="t-empty">
    <block wx:if="{{keyword}}">没有找到。换个词再试试。</block>
    <block wx:elif="{{filterKey}}">这一天还没有记东西。点下面这个大按钮，记一条。</block>
    <block wx:else>还没有记过东西。点下面这个大按钮，记第一条。</block>
  </view>

  <!-- 底部主按钮，固定在拇指区 -->
  <view class="btn btn-main btn-fixed" bindtap="goEdit" hover-class="hover">＋ 记一条</view>

  <!-- 删除后的撤销条：可逆操作不弹确认框 [S9][S10] -->
  <view class="undo-bar" wx:if="{{undoTitle}}">
    <view class="undo-text">刚删掉了「{{undoTitle}}」</view>
    <view class="undo-btn" bindtap="undoDelete" hover-class="hover">找回来</view>
  </view>

</view>
